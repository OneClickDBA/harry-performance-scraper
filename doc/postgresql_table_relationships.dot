digraph postgresql_table_relationships {
  graph [
    label="Harry - Performance Scraper for Oracle Database - PostgreSQL Partitioned Table Relationships",
    labelloc=t,
    fontsize=20,
    rankdir=LR,
    splines=spline,
    nodesep=0.8,
    ranksep=1.1
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#e8f1ff",
    fontsize=11,
    fontname="Helvetica"
  ];

  edge [
    fontsize=10,
    fontname="Helvetica"
  ];

  oracle_metric_samples [
    label="oracle_metric_samples\l\lPartitioned by RANGE (collected_at)\lcollected_at\lsource_database\lcontext\lmetric_name\lmetric_help\lmetric_type\lvalue\llabels jsonb\l\lIndexes\lcollected_at\lsource_database, context\llabels gin\l"
  ];

  oracle_sql_samples [
    label="oracle_sql_samples\l\lPartitioned by RANGE (collected_at)\lcollected_at\lsource_database\linst_id\lsql_id\lchild_number\lplan_hash_value\lparsing_schema_name\lmodule\lexecutions\lelapsed_time_micro\lcpu_time_micro\luser_io_wait_micro\lapplication_wait_micro\lconcurrency_wait_micro\lcluster_wait_micro\lbuffer_gets\ldisk_reads\ldirect_writes\lrows_processed\lfetches\lloads\linvalidations\lparse_calls\llast_active_time\l\lIndexes\lcollected_at\lsource_database, sql_id, child_number\lelapsed_time_micro desc\l"
  ];

  oracle_sql_texts [
    label="oracle_sql_texts\l\lsource_database PK\lsql_id PK\lsql_fulltext\lfirst_seen_at\llast_text_seen_at\llast_referenced_at\l\lIndexes\llast_referenced_at\l"
  ];

  oracle_sql_plans [
    label="oracle_sql_plans\l\lsource_database PK\linst_id PK\lsql_id PK\lchild_number PK\lplan_hash_value PK\lplan_line_id PK\lparent_id\ldepth\lposition\loperation\loptions\lobject_owner\lobject_name\lobject_type\loptimizer\lcost\lcardinality\lbytes\lcpu_cost\lio_cost\ltemp_space\lpartition_start\lpartition_stop\laccess_predicates\lfilter_predicates\lfirst_seen_at\llast_seen_at\llast_referenced_at\l\lIndexes\lsource_database, sql_id, plan_hash_value\llast_referenced_at\l"
  ];

  oracle_session_samples [
    label="oracle_session_samples\l\lPartitioned by RANGE (collected_at)\lcollected_at\lsource_database\linst_id\lsid\lserial_number\lusername\lstatus\lsql_id\lsql_child_number\lprev_sql_id\levent\lwait_class\lstate\lseconds_in_wait\lblocking_instance\lblocking_session\lmachine\lprogram\lmodule\laction\lservice_name\llogon_time\l\lIndexes\lcollected_at\lsource_database, sql_id\lsource_database, wait_class\l"
  ];

  oracle_blocking_session_samples [
    label="oracle_blocking_session_samples\l\lPartitioned by RANGE (collected_at)\lcollected_at\lsource_database\linst_id\lsid\lserial_number\lusername\lsql_id\levent\lwait_class\lblocking_instance\lblocking_session\lblocking_username\lblocking_sql_id\lblocking_event\l\lIndexes\lcollected_at\lsource_database, sql_id\l"
  ];

  oracle_database_activity_samples [
    label="oracle_database_activity_samples\l\lPartitioned by RANGE (sample_time)\lcollected_at\lsource_database\lsample_id\lsample_time\linst_id\lsession_id\lsession_serial_number\lsession_serial_number_key generated\lsession_type\luser_id\lsql_id\lsql_child_number\lsql_exec_id\lsql_exec_start\ltop_level_sql_id\lsession_state\levent\lwait_class\lwait_time_micro\ltime_waited_micro\lblocking_session\lblocking_session_serial_number\lblocking_inst_id\lcurrent_object_id\lcurrent_file_number\lcurrent_block_number\lprogram\lmodule\laction\lmachine\lpga_allocated\ltemp_space_allocated\lcon_id\lsample_source\lsample_duration_micro\lsql_plan_hash_value\lsql_full_plan_hash_value\lsql_plan_line_id\lservice_hash\lservice_name\lclient_identifier\l\lUnique\lsample_time, source_database, inst_id, sample_id, session_id, session_serial_number_key\l\lIndexes\lsample_time\lsource_database, sql_id, sample_time\lsource_database, wait_class, sample_time\lsource_database, sample_source, sample_time\l"
  ];

  oracle_database_status_samples [
    label="oracle_database_status_samples\l\lPartitioned by RANGE (collected_at)\lcollected_at\lsource_database\linst_id\linstance_name\linstance_status\ldatabase_status\lstartup_time\lopen_mode\ldatabase_role\lcdb\lcon_id\lcon_name\lplatform_name\l\lIndexes\lsource_database, collected_at desc\l"
  ];

  oracle_instance_samples [
    label="oracle_instance_samples\l\lPartitioned by RANGE (collected_at)\lcollected_at\lsource_database\linst_id\luser_sessions\lactive_user_sessions\lbackground_sessions\lprocess_count\lcpu_count\lsga_max_bytes\lpga_aggregate_limit\l\lIndexes\lsource_database, inst_id, collected_at desc\l"
  ];

  oracle_resource_limit_samples [
    label="oracle_resource_limit_samples\l\lPartitioned by RANGE (collected_at)\lcollected_at\lsource_database\linst_id\lresource_name\lcurrent_value\lmax_value\linitial_limit\llimit_value\llimit_unlimited\l\lIndexes\lsource_database, resource_name, inst_id, collected_at desc\l"
  ];

  oracle_tablespace_samples [
    label="oracle_tablespace_samples\l\lPartitioned by RANGE (collected_at)\lcollected_at\lsource_database\ltablespace_name\lcontents\lused_bytes\lfree_bytes\lmax_bytes\lused_percent\l\lIndexes\lsource_database, tablespace_name, collected_at desc\l"
  ];

  oracle_asm_diskgroup_samples [
    label="oracle_asm_diskgroup_samples\l\lPartitioned by RANGE (collected_at)\lcollected_at\lsource_database\linst_id\ldiskgroup_name\ltotal_bytes\lfree_bytes\lusable_bytes\l\lIndexes\lsource_database, diskgroup_name, inst_id, collected_at desc\l"
  ];

  oracle_system_counter_samples [
    label="oracle_system_counter_samples\l\lPartitioned by RANGE (collected_at)\lcollected_at\lsource_database\linst_id\lcon_id\lstat_name\lcumulative_value\ldelta_value\linterval_seconds\lcounter_reset\l\lIndexes\lsource_database, stat_name, inst_id, con_id, collected_at desc\l"
  ];

  oracle_wait_class_samples [
    label="oracle_wait_class_samples\l\lPartitioned by RANGE (collected_at)\lcollected_at\lsource_database\linst_id\lcon_id\lwait_class\lcumulative_wait_micro\ldelta_wait_micro\linterval_seconds\lcounter_reset\l\lIndexes\lsource_database, wait_class, inst_id, con_id, collected_at desc\l"
  ];

  oracle_system_metric_samples [
    label="oracle_system_metric_samples\l\lPartitioned by RANGE (collected_at)\lcollected_at\lsource_database\linst_id\lcon_id\lmetric_name\lvalue\lunit\l\lIndexes\lsource_database, metric_name, inst_id, con_id, collected_at desc\l"
  ];

  oracle_scrape_status [
    label="oracle_scrape_status\l\lPartitioned by RANGE (collected_at)\lcollected_at\lsource_database\lcollector\lsuccess\lduration_seconds\lsample_count\lerror_message\l\lIndexes\lsource_database, collector, collected_at desc\l"
  ];

  oracle_latest_scrape_status [
    label="oracle_latest_scrape_status\l\lCurrent state (non-partitioned)\lcollected_at\lsource_database PK\lcollector PK\lsuccess\lduration_seconds\lsample_count\lerror_message\l"
  ];

  harry_repository_daily_ingest [
    label="harry_repository_daily_ingest\l\lPartitioned by RANGE (sample_day)\lsample_day PK\lsource_database PK\ladditional_metric_rows\lsql_sample_rows\lsql_text_writes\lsql_plan_operation_writes\lsession_sample_rows\lblocking_session_sample_rows\ldatabase_activity_sample_rows\ldatabase_status_sample_rows\linstance_sample_rows\lresource_limit_sample_rows\ltablespace_sample_rows\lasm_diskgroup_sample_rows\lsystem_counter_sample_rows\lwait_class_sample_rows\lsystem_metric_sample_rows\lscrape_status_rows\lfirst_sample_at\llast_sample_at\llast_sql_sample_at\llast_session_sample_at\llast_database_activity_sample_at\llast_flushed_at\l"
  ];

  // Logical relationships used by dashboards and analysis queries.
  oracle_session_samples -> oracle_sql_samples [
    label="logical: source_database, sql_id, sql_child_number",
    style=dashed,
    color="#666666"
  ];

  oracle_blocking_session_samples -> oracle_session_samples [
    label="logical: source_database, inst_id/sid/serial_number",
    style=dashed,
    color="#666666"
  ];

  oracle_database_activity_samples -> oracle_sql_samples [
    label="logical: source_database, sql_id, sql_child_number",
    style=dashed,
    color="#666666"
  ];

  oracle_database_activity_samples -> oracle_sql_plans [
    label="logical: source_database, inst_id, sql_id, sql_child_number, sql_plan_hash_value, sql_plan_line_id",
    style=dashed,
    color="#666666"
  ];

  oracle_sql_samples -> oracle_sql_texts [
    label="logical: source_database, sql_id",
    style=dashed,
    color="#666666"
  ];

  oracle_sql_samples -> oracle_sql_plans [
    label="logical: source_database, inst_id, sql_id, child_number, plan_hash_value",
    style=dashed,
    color="#666666"
  ];

  oracle_sql_plans -> oracle_sql_texts [
    label="logical: source_database, sql_id",
    style=dashed,
    color="#666666"
  ];

  oracle_session_samples -> oracle_sql_texts [
    label="logical: source_database, sql_id / prev_sql_id",
    style=dashed,
    color="#666666"
  ];

  oracle_blocking_session_samples -> oracle_sql_texts [
    label="logical: source_database, sql_id / blocking_sql_id",
    style=dashed,
    color="#666666"
  ];

  oracle_database_activity_samples -> oracle_sql_texts [
    label="logical: source_database, sql_id / top_level_sql_id",
    style=dashed,
    color="#666666"
  ];

  oracle_database_activity_samples -> oracle_session_samples [
    label="logical: source_database, inst_id, session_id, session_serial_number",
    style=dashed,
    color="#666666"
  ];

  oracle_instance_samples -> oracle_database_status_samples [
    label="logical: source_database, inst_id",
    style=dashed,
    color="#666666"
  ];

  oracle_resource_limit_samples -> oracle_instance_samples [
    label="logical: source_database, inst_id",
    style=dashed,
    color="#666666"
  ];

  oracle_asm_diskgroup_samples -> oracle_database_status_samples [
    label="logical: source_database, inst_id",
    style=dashed,
    color="#666666"
  ];

  oracle_system_counter_samples -> oracle_instance_samples [
    label="logical: source_database, inst_id",
    style=dashed,
    color="#666666"
  ];

  oracle_wait_class_samples -> oracle_instance_samples [
    label="logical: source_database, inst_id",
    style=dashed,
    color="#666666"
  ];

  oracle_system_metric_samples -> oracle_instance_samples [
    label="logical: source_database, inst_id",
    style=dashed,
    color="#666666"
  ];

  oracle_scrape_status -> oracle_database_status_samples [
    label="logical: source_database",
    style=dashed,
    color="#666666"
  ];

  oracle_scrape_status -> oracle_latest_scrape_status [
    label="latest row upsert: source_database, collector",
    color="#2f6f44"
  ];

  repository_ingest_sources [
    shape=note,
    fillcolor="#e4f2e4",
    label="Successful writes to all sample,\lstatus, SQL text, and SQL plan datasets\l"
  ];

  repository_ingest_sources -> harry_repository_daily_ingest [
    label="buffered accounting: UTC day, source_database, typed counters",
    style=dashed,
    color="#2f6f44"
  ];
}
