        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with latest as (\n  select source_database, max(collected_at) as collected_at\n  from oracle_session_samples\n  where $__timeFilter(collected_at)\n    and source_database = ${source_database:sqlstring}\n  group by source_database\n)\nselect\n  coalesce(s.wait_class, 'UNKNOWN') as wait_class,\n  coalesce(s.event, 'UNKNOWN') as event,\n  count(*) as sessions,\n  count(*) filter (where s.sql_id is not null) as sql_sessions,\n  max(s.seconds_in_wait) as max_seconds_in_wait,\n  max(s.sql_id) as example_sql_id,\n  max(s.module) as example_module,\n  max(s.machine) as example_machine\nfrom oracle_session_samples s\njoin latest l on l.source_database = s.source_database and l.collected_at = s.collected_at\nwhere s.status = 'ACTIVE'\n  and coalesce(s.wait_class, 'Idle') <> 'Idle'\ngroup by coalesce(s.wait_class, 'UNKNOWN'), coalesce(s.event, 'UNKNOWN')\norder by sessions desc, max_seconds_in_wait desc nulls last\nlimit 50;",
          "refId": "A",
          "sql": {
            "columns": [
