          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with snapshot as (\n  select collected_at\n  from oracle_latest_scrape_status\n  where source_database = ${source_database:sqlstring}\n    and collector = 'scheduled'\n    and $__timeFilter(collected_at)\n  order by collected_at desc\n  limit 1\n), blocked as (\n  select b.*,\n    s.seconds_in_wait,\n    s.module as waiter_module\n  from snapshot x\n  join oracle_blocking_session_samples b\n    on b.source_database = ${source_database:sqlstring}\n   and b.collected_at = x.collected_at\n  left join oracle_session_samples s\n    on s.source_database = b.source_database\n   and s.collected_at = b.collected_at\n   and s.inst_id = b.inst_id\n   and s.sid = b.sid\n)\nselect\n  count(*)::bigint as blocked_sessions,\n  count(distinct concat(blocking_instance, ':', blocking_session)) filter (\n    where blocking_instance is not null\n      and blocking_session is not null\n      and not exists (\n        select 1\n        from blocked waiter\n        where waiter.inst_id = blocked.blocking_instance\n          and waiter.sid = blocked.blocking_session\n      )\n  )::bigint as root_blockers,\n  coalesce(max(seconds_in_wait), 0)::bigint as longest_blocked_wait_seconds,\n  count(distinct concat_ws('|', username, waiter_module))::bigint as affected_users_modules\nfrom blocked;\n",
          "refId": "A"
        }
      ],
      "title": "Current Blocking Impact",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "description": "Current RAC-aware blocking relationships. Red nodes are root blockers, orange nodes both wait and block, and yellow nodes are blocked sessions. Edge labels show the wait event and current wait duration.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 7,
      "options": {
        "edges": {
          "mainStatUnit": "",
          "secondaryStatUnit": ""
        },
        "nodes": {
          "mainStatUnit": "",
          "secondaryStatUnit": ""
        }
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with snapshot as (\n  select collected_at\n  from oracle_latest_scrape_status\n  where source_database = ${source_database:sqlstring}\n    and collector = 'scheduled'\n    and $__timeFilter(collected_at)\n  order by collected_at desc\n  limit 1\n), relationships as (\n  select b.*\n  from snapshot x\n  join oracle_blocking_session_samples b\n    on b.source_database = ${source_database:sqlstring}\n   and b.collected_at = x.collected_at\n), node_ids as (\n  select inst_id, sid from relationships\n  union\n  select blocking_instance, blocking_session\n  from relationships\n  where blocking_instance is not null and blocking_session is not null\n), classified as (\n  select n.inst_id, n.sid,\n    exists (\n      select 1 from relationships r\n      where r.inst_id = n.inst_id and r.sid = n.sid\n    ) as is_waiter,\n    exists (\n      select 1 from relationships r\n      where r.blocking_instance = n.inst_id and r.blocking_session = n.sid\n    ) as is_blocker,\n    (\n      select count(*) from relationships r\n      where r.blocking_instance = n.inst_id and r.blocking_session = n.sid\n    ) as blocked_count\n  from node_ids n\n), enriched as (\n  select c.*,\n    coalesce(\n      s.username,\n      (select max(r.blocking_username) from relationships r\n       where r.blocking_instance = c.inst_id and r.blocking_session = c.sid),\n      '(unknown)'\n    ) as username,\n    coalesce(\n      s.sql_id,\n      (select max(r.blocking_sql_id) from relationships r\n       where r.blocking_instance = c.inst_id and r.blocking_session = c.sid)\n    ) as sql_id,\n    coalesce(\n      s.event,\n      (select max(r.blocking_event) from relationships r\n       where r.blocking_instance = c.inst_id and r.blocking_session = c.sid)\n    ) as event,\n    s.module,\n    s.program,\n    s.machine,\n    s.seconds_in_wait\n  from classified c\n  left join snapshot x on true\n  left join oracle_session_samples s\n    on s.source_database = ${source_database:sqlstring}\n   and s.collected_at = x.collected_at\n   and s.inst_id = c.inst_id\n   and s.sid = c.sid\n)\nselect\n  concat(inst_id, ':', sid) as id,\n  concat(username, ' [', inst_id, ':', sid, ']') as title,\n  coalesce(module, program, machine, 'No application context') as \"subTitle\",\n  case\n    when is_blocker and not is_waiter then 'ROOT BLOCKER'\n    when is_blocker and is_waiter then 'INTERMEDIATE BLOCKER'\n    else 'BLOCKED SESSION'\n  end as \"mainStat\",\n  case\n    when is_blocker then concat(blocked_count, ' session', case when blocked_count = 1 then '' else 's' end, ' blocked')\n    else coalesce(event, 'Waiting')\n  end as \"secondaryStat\",\n  case\n    when is_blocker and not is_waiter then '#E02F44'\n    when is_blocker and is_waiter then '#FF9830'\n    else '#F2CC0C'\n  end as color,\n  sql_id as \"detail__SQL ID\",\n  event as \"detail__Wait event\",\n  module as \"detail__Module\",\n  program as \"detail__Program\",\n  machine as \"detail__Machine\",\n  seconds_in_wait as \"detail__Wait seconds\"\nfrom enriched\norder by is_blocker desc, blocked_count desc, inst_id, sid;\n",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with snapshot as (\n  select collected_at\n  from oracle_latest_scrape_status\n  where source_database = ${source_database:sqlstring}\n    and collector = 'scheduled'\n    and $__timeFilter(collected_at)\n  order by collected_at desc\n  limit 1\n)\nselect\n  concat(b.blocking_instance, ':', b.blocking_session, '->', b.inst_id, ':', b.sid) as id,\n  concat(b.blocking_instance, ':', b.blocking_session) as source,\n  concat(b.inst_id, ':', b.sid) as target,\n  coalesce(b.event, 'Blocked') as \"mainStat\",\n  case when s.seconds_in_wait is not null\n    then concat(s.seconds_in_wait, ' s')\n    else null\n  end as \"secondaryStat\",\n  case\n    when coalesce(s.seconds_in_wait, 0) >= 60 then '#E02F44'\n    when coalesce(s.seconds_in_wait, 0) >= 30 then '#FF9830'\n    else '#F2CC0C'\n  end as color,\n  greatest(1, least(10, ln(coalesce(s.seconds_in_wait, 0) + 1)))::double precision as thickness,\n  coalesce(s.seconds_in_wait, 0) >= 60 as highlighted\nfrom snapshot x\njoin oracle_blocking_session_samples b\n  on b.source_database = ${source_database:sqlstring}\n and b.collected_at = x.collected_at\nleft join oracle_session_samples s\n  on s.source_database = b.source_database\n and s.collected_at = b.collected_at\n and s.inst_id = b.inst_id\n and s.sid = b.sid\nwhere b.blocking_instance is not null\n  and b.blocking_session is not null\norder by coalesce(s.seconds_in_wait, 0) desc, source, target;\n",
          "refId": "B"
        }
      ],
      "title": "Current Blocking Chains",
      "type": "nodeGraph"
    },
