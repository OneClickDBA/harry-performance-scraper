        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select\n  source_database,\n  collector,\n  success,\n  collected_at as last_collection,\n  extract(epoch from (now() - collected_at))::double precision as data_age_seconds,\n  round(duration_seconds::numeric, 3) as duration_seconds,\n  sample_count,\n  error_message\nfrom oracle_latest_scrape_status\norder by success, data_age_seconds desc, source_database, collector;",
          "refId": "A"
        }
      ],
      "title": "Collector Health Across All Databases",
      "type": "table"
