        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select\n  source_database,\n  collector,\n  case when not success then 'FAILED' else 'STALE' end as state,\n  collected_at as last_collection,\n  extract(epoch from (now() - collected_at))::double precision as data_age_seconds,\n  error_message\nfrom oracle_latest_scrape_status\nwhere not success\n   or collected_at < now() - interval '3 minutes'\norder by success, collected_at, source_database, collector;",
          "refId": "A"
        }
      ],
