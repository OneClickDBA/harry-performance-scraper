          "rawSql": "select\n       case when session_state = 'ON CPU' then 'CPU + CPU Wait' else coalesce(wait_class, 'Other') end as activity_class,\n       coalesce(event, 'ON CPU') as event,\n       count(*) as active_samples,\n       count(distinct sql_id) filter (where sql_id is not null) as sql_count,\n       count(distinct (inst_id, session_id, session_serial_number)) as session_count,\n       max(sql_id) as example_sql_id\nfrom oracle_database_activity_samples\nwhere $__timeFilter(sample_time)\n  and source_database = ${source_database:sqlstring}\ngroup by case when session_state = 'ON CPU' then 'CPU + CPU Wait' else coalesce(wait_class, 'Other') end,\n         coalesce(event, 'ON CPU')\norder by active_samples desc\nlimit 25;",
