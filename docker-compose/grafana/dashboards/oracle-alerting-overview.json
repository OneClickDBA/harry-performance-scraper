      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with capacity as (\n  select\n    source_database,\n    'Tablespace'::text as category,\n    tablespace_name as object_name,\n    null::text as inst_id,\n    used_percent,\n    90.0::double precision as alert_threshold\n  from oracle_latest_tablespace_samples\n  where used_percent >= 80\n  union all\n  select\n    source_database,\n    'Resource limit',\n    resource_name,\n    inst_id::text,\n    used_percent,\n    85.0::double precision\n  from oracle_latest_resource_limit_samples\n  where not limit_unlimited\n    and limit_value > 0\n    and used_percent >= 75\n  union all\n  select\n    source_database,\n    'ASM diskgroup',\n    diskgroup_name,\n    inst_id::text,\n    used_percent,\n    90.0::double precision\n  from oracle_latest_asm_diskgroup_samples\n  where used_percent >= 80\n)\nselect\n  source_database,\n  category,\n  object_name,\n  inst_id,\n  used_percent,\n  alert_threshold,\n  case\n    when used_percent > alert_threshold then 'ALERT THRESHOLD'\n    else 'WATCH'\n  end as state\nfrom capacity\norder by (used_percent / alert_threshold) desc, source_database, category, object_name;",
          "refId": "A"
        }
      ],
      "title": "Current Capacity Risks",
      "type": "table"
    },
