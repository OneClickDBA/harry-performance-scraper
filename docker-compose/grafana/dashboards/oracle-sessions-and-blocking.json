          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with latest as (\n  select source_database, max(collected_at) as collected_at\n  from oracle_session_samples\n  where $__timeFilter(collected_at)\n    and source_database = ${source_database:sqlstring}\n  group by source_database\n)\nselect\n  s.inst_id,\n  s.sid,\n  s.serial_number,\n  s.username,\n  s.sql_id,\n  s.sql_child_number,\n  s.event,\n  s.wait_class,\n  s.state,\n  s.seconds_in_wait,\n  s.module,\n  s.action,\n  s.program,\n  s.machine,\n  s.service_name\nfrom oracle_session_samples s\njoin latest l on l.source_database = s.source_database and l.collected_at = s.collected_at\nwhere s.status = 'ACTIVE'\n  and s.sql_id is not null\norder by s.seconds_in_wait desc nulls last, s.inst_id, s.sid;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
