          "rawSql": "select\n  s.source_database,\n  s.db_unique_name,\n  s.dbid,\n  s.database_version_full,\n  s.database_role,\n  s.protection_mode,\n  s.protection_level,\n  s.inst_id,\n  s.instance_name,\n  s.instance_status,\n  s.database_status,\n  s.open_mode,\n  s.startup_time,\n  s.collected_at as last_observation\nfrom oracle_database_status_samples s\njoin oracle_latest_scrape_status st\n  on st.source_database = s.source_database\n and st.collector = 'operational.database_status'\n and st.collected_at = s.collected_at\norder by s.source_database, s.inst_id;",
