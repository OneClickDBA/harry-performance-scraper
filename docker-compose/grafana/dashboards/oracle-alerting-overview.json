      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with asm_capacity as (\n  select\n    string_agg(source_database, ', ' order by source_database) as source_database,\n    'ASM diskgroup'::text as category,\n    diskgroup_name as object_name,\n    inst_id::text as inst_id,\n    used_percent,\n    90.0::double precision as alert_threshold\n  from oracle_latest_asm_diskgroup_samples\n  where used_percent >= 80\n  group by diskgroup_name, inst_id, total_bytes, free_bytes, usable_bytes, used_percent\n), capacity as (\n  select source_database, 'Tablespace maximum'::text as category, tablespace_name as object_name,\n    null::text as inst_id, used_percent, 90.0::double precision as alert_threshold\n  from oracle_latest_tablespace_samples\n  where used_percent >= 80\n  union all\n  select source_database, 'Tablespace allocation', tablespace_name, null::text,\n    used_bytes * 100.0 / nullif(allocated_bytes, 0), 95.0::double precision\n  from oracle_latest_tablespace_samples\n  where allocated_bytes > 0 and used_bytes * 100.0 / allocated_bytes >= 85\n  union all\n  select source_database, 'Resource limit', resource_name, inst_id::text,\n    used_percent, 85.0::double precision\n  from oracle_latest_resource_limit_samples\n  where not limit_unlimited and limit_value > 0 and used_percent >= 75\n  union all\n  select * from asm_capacity\n)\nselect source_database, category, object_name, inst_id,\n  round(used_percent::numeric, 2) as used_percent, alert_threshold,\n  case when used_percent > alert_threshold then 'ALERT THRESHOLD' else 'WATCH' end as state\nfrom capacity\norder by (used_percent / alert_threshold) desc, source_database, category, object_name;",
          "refId": "A"
        }
      ],
      "title": "Current Capacity Risks",
      "type": "table"
    },
