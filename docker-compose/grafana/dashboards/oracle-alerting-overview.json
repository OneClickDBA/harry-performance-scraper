          "rawSql": "with instances as (\n  select\n    s.source_database,\n    sum(s.cpu_count)::double precision as cpu_capacity,\n    sum(s.pga_allocated_bytes)::double precision as pga_allocated_bytes,\n    sum(s.pga_max_allocated_bytes)::double precision as pga_peak_bytes,\n    sum(s.pga_aggregate_limit)::double precision as pga_limit_bytes\n  from oracle_instance_samples s\n  join oracle_latest_scrape_status st\n    on st.source_database = s.source_database\n   and st.collector = 'operational.instance'\n   and st.collected_at = s.collected_at\n  group by s.source_database\n), cpu as (\n  select\n    r.source_database,\n    sum(r.value_per_second) / 1000000.0 as db_cpu_cores\n  from oracle_system_counter_rates r\n  join oracle_latest_scrape_status st\n    on st.source_database = r.source_database\n   and st.collector = 'operational.cpu_io_counters'\n   and st.collected_at = r.collected_at\n  where r.con_id = 0 and r.stat_name = 'DB CPU' and r.value_per_second is not null\n  group by r.source_database\n)\nselect\n  i.source_database,\n  round(c.db_cpu_cores::numeric, 2) as db_cpu_cores,\n  i.cpu_capacity,\n  round((c.db_cpu_cores * 100.0 / nullif(i.cpu_capacity, 0))::numeric, 1) as cpu_used_percent,\n  i.pga_allocated_bytes,\n  i.pga_peak_bytes,\n  i.pga_limit_bytes,\n  round((i.pga_allocated_bytes * 100.0 / nullif(i.pga_limit_bytes, 0))::numeric, 1) as pga_current_percent,\n  round((i.pga_peak_bytes * 100.0 / nullif(i.pga_limit_bytes, 0))::numeric, 1) as pga_peak_percent\nfrom instances i\nleft join cpu c using (source_database)\norder by greatest(\n  coalesce(c.db_cpu_cores / nullif(i.cpu_capacity, 0), 0),\n  coalesce(i.pga_allocated_bytes / nullif(i.pga_limit_bytes, 0), 0)\n) desc, i.source_database;",
          "refId": "A"
        }
      ],
      "title": "Current CPU and PGA Pressure",
      "type": "table"
    },
