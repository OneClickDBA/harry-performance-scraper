      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "with activity as (\n  select date_bin(($__interval_ms || ' milliseconds')::interval, sample_time, '1970-01-01'::timestamptz) as bucket,\n         sample_time,\n         case when session_state = 'ON CPU' then 'CPU + CPU Wait' else coalesce(wait_class, 'Other') end as activity_class\n  from oracle_database_activity_samples\n  where $__timeFilter(sample_time)\n    and source_database = ${source_database:sqlstring}\n), bucket_samples as (\n  select bucket,\n         count(distinct sample_time) as sample_points\n  from activity\n  group by bucket\n)\nselect a.bucket as \"time\",\n       a.activity_class as metric,\n       count(*)::double precision / nullif(max(b.sample_points), 0) as value\nfrom activity a\njoin bucket_samples b on b.bucket = a.bucket\ngroup by a.bucket, a.activity_class\norder by 1;",
          "refId": "A"
        }
      ],
      "title": "Average Active Sessions by Wait Class",
      "type": "timeseries"
    },
