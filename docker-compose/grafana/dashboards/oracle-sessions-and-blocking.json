          "rawSql": "with snapshot as (\n  select collected_at\n  from oracle_latest_scrape_status\n  where source_database = ${source_database:sqlstring}\n    and collector = 'scheduled'\n    and $__timeFilter(collected_at)\n  order by collected_at desc\n  limit 1\n)\nselect\n  b.inst_id,\n  b.sid,\n  b.serial_number,\n  b.username,\n  b.sql_id,\n  b.event,\n  b.wait_class,\n  s.seconds_in_wait,\n  s.module,\n  s.machine,\n  b.blocking_instance,\n  b.blocking_session,\n  b.blocking_username,\n  b.blocking_sql_id,\n  b.blocking_event\nfrom snapshot x\njoin oracle_blocking_session_samples b\n  on b.source_database = ${source_database:sqlstring}\n and b.collected_at = x.collected_at\nleft join oracle_session_samples s\n  on s.source_database = b.source_database\n and s.collected_at = b.collected_at\n and s.inst_id = b.inst_id\n and s.sid = b.sid\norder by s.seconds_in_wait desc nulls last, b.inst_id, b.sid;\n",
