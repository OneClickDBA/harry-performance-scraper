          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select sql_id,\n       count(*) as active_samples,\n       sum(case when session_state = 'ON CPU' then 1 else 0 end) as cpu_samples,\n       sum(case when wait_class = 'User I/O' then 1 else 0 end) as user_io_samples,\n       sum(case when wait_class = 'Network' then 1 else 0 end) as network_samples,\n       sum(case when wait_class = 'Application' then 1 else 0 end) as application_samples,\n       sum(case when wait_class = 'Concurrency' then 1 else 0 end) as concurrency_samples,\n       max(module) as module,\n       max(program) as program\nfrom oracle_database_activity_samples\nwhere $__timeFilter(sample_time)\n  and source_database = ${source_database:sqlstring}\n  and sql_id is not null\ngroup by sql_id\norder by active_samples desc\nlimit 25;",
          "refId": "A"
        }
      ],
      "title": "Top SQL",
