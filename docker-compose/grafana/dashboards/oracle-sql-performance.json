        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with deltas as (\n  select\n    source_database,\n    inst_id,\n    sql_id,\n    child_number,\n    plan_hash_value,\n    max(coalesce(elapsed_time_micro, 0)) - min(coalesce(elapsed_time_micro, 0)) as elapsed_micro_delta,\n    max(coalesce(cpu_time_micro, 0)) - min(coalesce(cpu_time_micro, 0)) as cpu_micro_delta,\n    max(coalesce(user_io_wait_micro, 0)) - min(coalesce(user_io_wait_micro, 0)) as user_io_micro_delta,\n    max(coalesce(executions, 0)) - min(coalesce(executions, 0)) as executions_delta,\n    max(coalesce(buffer_gets, 0)) - min(coalesce(buffer_gets, 0)) as buffer_gets_delta,\n    max(coalesce(disk_reads, 0)) - min(coalesce(disk_reads, 0)) as disk_reads_delta,\n    max(parsing_schema_name) as parsing_schema_name,\n    max(module) as module\n  from oracle_sql_samples\n  where $__timeFilter(collected_at)\n    and source_database = ${source_database:sqlstring}\n  group by source_database, inst_id, sql_id, child_number, plan_hash_value\n)\nselect\n  inst_id,\n  sql_id,\n  child_number,\n  plan_hash_value,\n  round(elapsed_micro_delta / 1000000.0, 3) as elapsed_seconds_delta,\n  round(cpu_micro_delta / 1000000.0, 3) as cpu_seconds_delta,\n  round(user_io_micro_delta / 1000000.0, 3) as user_io_seconds_delta,\n  executions_delta,\n  buffer_gets_delta,\n  disk_reads_delta,\n  parsing_schema_name,\n  module,\n  left((select t.sql_fulltext from oracle_sql_texts t where t.source_database = deltas.source_database and t.sql_id = deltas.sql_id), 240) as sql_preview\nfrom deltas\nwhere elapsed_micro_delta > 0\norder by elapsed_micro_delta desc\nlimit 50;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Top SQL by Elapsed Time Delta",
      "type": "table"
    },
